# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
GEMINI_API_KEY=replace_with_your_gemini_api_key
SESSION_SECRET_KEY=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=2592000
DATABASE_URL=sqlite:///./conceptviva.db
FRONTEND_URL=http://localhost:3000

# Keep false on normal production hosts. Enable only in a trusted sandbox/container.
ENABLE_CODE_EXECUTION=false

# Optional rate limits
AI_REQUESTS_PER_MINUTE=20
GENERAL_REQUESTS_PER_MINUTE=120
SESSION_STARTS_PER_MINUTE=20
