# Copy to .env.local (local dev) or .env (docker compose) and replace dummy values.
# Never commit real keys.

# ---------------- Frontend (Next.js)
PYTHON_BACKEND_URL=http://127.0.0.1:8000
# Extra dev origins, e.g. to open the dev server from a phone on your LAN:
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20

# ---------------- Backend: core
APP_ENV=development
LOG_LEVEL=INFO
SESSION_SECRET_KEY=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=2592000
DATABASE_URL=sqlite:///./conceptviva.db
# Production (Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTO_MIGRATE_SQLITE=true
FRONTEND_URL=http://localhost:3000
# Comma-separated; defaults to localhost:3000 + FRONTEND_URL
# CORS_ORIGINS=http://localhost:3000
# Number of proxies whose X-Forwarded-For entries are trusted (Vercel -> Render = 2)
TRUSTED_PROXY_HOPS=0

# ---------------- Gemini / LLM gateway
GEMINI_API_KEY=your_dummy_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RESET_SECONDS=30

# ---------------- Redis (rate limiting, cache, judge queue). Empty = in-process fallbacks, judge off.
REDIS_URL=
AI_REQUESTS_PER_MINUTE=20
GENERAL_REQUESTS_PER_MINUTE=120
SESSION_STARTS_PER_MINUTE=20

# ---------------- Code judge (never executes code inside the API)
JUDGE_ENABLED=false
# judge0 (recommended in production) | sandbox (docker compose) | local (dev only)
JUDGE_EXECUTOR=judge0
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_PYTHON_LANGUAGE_ID=71
SANDBOX_URL=
SANDBOX_SHARED_SECRET=replace_with_a_long_random_secret
# Only for local experiments: runs submissions as a limited subprocess on the worker host.
JUDGE_ALLOW_UNSAFE_LOCAL=false
JUDGE_WAIT_SECONDS=15
JUDGE_CPU_SECONDS=2
JUDGE_WALL_SECONDS=5
JUDGE_MEMORY_MB=256

# ---------------- Google sign-in (optional; guest mode works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console:
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false

# ---------------- Observability and analytics
# Bearer token for /metrics (in production /metrics is hidden without it)
METRICS_TOKEN=
# Bearer token for /analytics/summary (disabled when empty)
ANALYTICS_ADMIN_TOKEN=
